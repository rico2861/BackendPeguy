PORT=5000

# Postgres connection string (Supabase). Use the "Session pooler" URI from
# your Supabase project's Connect dialog (port 5432, host ending in
# .pooler.supabase.com) — it's IPv4-compatible, which most hosts
# (including Render) need. Percent-encode any special characters in the
# password.
DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Image uploads (logos, avatars, justificatifs de paiement) via Cloudflare R2 ---
# S3-compatible: Account ID + API token from the Cloudflare dashboard
# (R2 -> Manage API tokens), plus the bucket's public URL (R2 -> bucket ->
# Settings -> Public access).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Long random string, e.g. generated with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=2h
# Separate secret for refresh tokens — keep it different from JWT_SECRET so
# leaking one doesn't compromise the other.
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# --- Transactional emails (welcome, password reset, payment confirmation) ---
# Use a mailbox on a domain of your own, not a personal Gmail — the display
# name in SMTP_FROM only matters if the address itself is on a domain you
# control (a personal Gmail always shows the account's own name/branding).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PeguyTbn <no-reply@example.com>

# --- Web push notifications (daily picks/combos) ---
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@peguytbn.local

# Bootstrap admin account, created automatically on first boot if it
# doesn't exist yet. Change the password immediately after first login.
ADMIN_EMAIL=admin@peguytbn.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Super Admin

# Break-glass admin creation: POST /api/auth/admin/bootstrap with this PIN
# creates an extra admin account without needing an existing one. Leave
# empty to disable the endpoint entirely.
ADMIN_CREATE_PIN=

# --- Live Scanner: real scores + real odds (both free, both optional) ---
# Without these two keys, /api/live/matches responds with an empty list
# and an explanatory message instead of erroring.

# Free key (12 top leagues, fixtures/results/live scores, 10 req/min):
# register at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Free key (500 credits/month, real bookmaker odds, no card required):
# register at https://the-odds-api.com
ODDS_API_KEY=

# --- MonCash (Digicel Haiti) online payments for VIP plans ---
# Get merchant credentials from the MonCash business portal (sandbox
# first, then live once approved). Without these, /api/payments/moncash/*
# responds with a clear "not configured" error instead of a crash.
MONCASH_MODE=sandbox
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=

# --- Bazik (MonCash aggregator) online payments for VIP plans ---
# Get credentials from your Bazik dashboard -> Developers. Environment
# (sandbox/production) is determined by which pair you use — Bazik uses a
# single base URL for both. Without these, /api/payments/bazik/*
# responds with a clear "not configured" error instead of a crash.
BAZIK_API_URL=https://api.bazik.io
BAZIK_USER_ID=
BAZIK_SECRET_KEY=
# Per-environment webhook signing secret (Dashboard -> Developers ->
# Webhook Secret), used to verify X-Bazik-Signature on /bazik/notify.
BAZIK_WEBHOOK_SECRET=

# --- NOWPayments (crypto payments) for VIP plans ---
# API key + IPN secret from the NOWPayments dashboard (Settings ->
# API keys / IPN settings). NOWPAYMENTS_MODE=sandbox uses their
# separate sandbox account+API (different keys than live).
NOWPAYMENTS_MODE=live
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Public base URLs used to build MonCash/NOWPayments callback URLs.
# MUST be internet-reachable — localhost will NOT work once pasted into
# either provider's dashboard. Use an ngrok tunnel for local testing, or
# your real deployed URLs in production.
PUBLIC_API_URL=http://localhost:5000/api
PUBLIC_APP_URL=http://localhost:5173

# CORS allowlist: PUBLIC_APP_URL above is always allowed. Add any extra
# browser origins here (comma-separated, e.g. a custom domain) — the
# Capacitor/Android app and server-to-server calls (webhooks, curl) are
# unaffected, CORS only restricts browser callers.
EXTRA_CORS_ORIGINS=
